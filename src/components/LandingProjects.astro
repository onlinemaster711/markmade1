---
---
<section class="zone projects" id="projekte">
  <div class="container">
    <div class="projects-head reveal">
      <div class="kicker"><span class="rule"></span><span>Eigene Projekte</span></div>
      <h2 class="zone-h2 center">[SEKTION_PROJEKTE_HEADLINE_PLATZHALTER]</h2>
      <!-- Empfehlung: "Wir reden nicht über KI. Wir bauen sie." -->
      <p class="lead">[SEKTION_PROJEKTE_SUBLINE_PLATZHALTER]</p>
      <!-- Empfehlung: "Zwei eigene Projekte. Live im Einsatz." -->
    </div>

    <div class="projects-grid">

      <article class="project-card reveal">
        <div class="project-media">
          {/* TEMPORÄR (Phase 1B): Inline-SVG-Platzhalter. Beim Befüllen in Phase 1C komplett ersetzen durch:
              <img src="[SCREENSHOT_SKRIPTGENERATOR_PLATZHALTER]" alt="Skriptgenerator — KI-Tool für Skripterstellung" loading="lazy" width="800" height="500" />
          */}
          <svg width="100%" height="100%" viewBox="0 0 800 500" xmlns="http://www.w3.org/2000/svg" role="img" aria-label="Skriptgenerator — Vorschau folgt" style="display:block">
            <rect width="800" height="500" fill="#E7E1D4"/>
            <rect x="20" y="20" width="760" height="460" fill="none" stroke="#C7BFAC" stroke-width="1"/>
            <text x="400" y="258" text-anchor="middle" font-family="Roboto Slab, Georgia, serif" font-size="22" font-weight="500" fill="#6E665A">Skriptgenerator — Vorschau folgt</text>
          </svg>
        </div>
        <span class="project-tag">[SKRIPTGENERATOR_TAGLINE_PLATZHALTER]</span>
        <h3 class="project-name">Skriptgenerator</h3>
        <p class="project-pitch">[SKRIPTGENERATOR_PITCH_PLATZHALTER]</p>
        <ul class="project-caps">
          <li>[SKRIPTGENERATOR_CAPABILITY_1]</li>
          <li>[SKRIPTGENERATOR_CAPABILITY_2]</li>
          <li>[SKRIPTGENERATOR_CAPABILITY_3]</li>
        </ul>
        <div class="project-foot">
          <span class="project-status status-live">Live</span>
          <a class="project-link" href="https://skriptgenerator.com" target="_blank" rel="noopener noreferrer">skriptgenerator.com <span class="arrow">→</span></a>
        </div>
      </article>

      <article class="project-card reveal">
        <div class="project-media">
          {/* TEMPORÄR (Phase 1B): Inline-SVG-Platzhalter. Beim Befüllen in Phase 1C komplett ersetzen durch:
              <img src="[SCREENSHOT_GARAGE_PLATZHALTER]" alt="Garage — Voice-First Bordbuch" loading="lazy" width="800" height="500" />
          */}
          <svg width="100%" height="100%" viewBox="0 0 800 500" xmlns="http://www.w3.org/2000/svg" role="img" aria-label="Garage — Vorschau folgt" style="display:block">
            <rect width="800" height="500" fill="#E7E1D4"/>
            <rect x="20" y="20" width="760" height="460" fill="none" stroke="#C7BFAC" stroke-width="1"/>
            <text x="400" y="258" text-anchor="middle" font-family="Roboto Slab, Georgia, serif" font-size="22" font-weight="500" fill="#6E665A">Garage — Vorschau folgt</text>
          </svg>
        </div>
        <span class="project-tag">[GARAGE_TAGLINE_PLATZHALTER]</span>
        <!-- Empfehlung: "Voice-First Bordbuch" -->
        <h3 class="project-name">Garage</h3>
        <p class="project-pitch">[GARAGE_PITCH_PLATZHALTER]</p>
        <ul class="project-caps">
          <li>[GARAGE_CAPABILITY_1]</li>
          <li>[GARAGE_CAPABILITY_2]</li>
          <li>[GARAGE_CAPABILITY_3]</li>
        </ul>
        <div class="project-foot">
          <span class="project-status status-beta">In geschlossener Beta</span>
        </div>
      </article>

    </div>
  </div>
</section>
