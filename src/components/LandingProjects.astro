---
import { Image } from 'astro:assets';
import skriptgeneratorImg from '../assets/screenshots/skriptgenerator-app.webp';
import garageImg from '../assets/screenshots/garage-sammlung.webp';
---
<section class="zone projects" id="projekte">
  <div class="container">
    <div class="projects-head reveal">
      <div class="kicker"><span class="rule"></span><span>Was wir noch bauen</span></div>
      <h2 class="zone-h2">Eigene KI-Lösungen für deinen Betrieb.</h2>
      <p class="lead">Zwei Beispiele aus eigener Hand. Mit den gleichen Werkzeugen, die wir für deinen Betrieb einsetzen.</p>
    </div>

    <article class="proj-spread reveal">
      <div class="project-media">
        <Image
          src={skriptgeneratorImg}
          alt="Skriptgenerator App-Interface — Skript-Generierung in Echtzeit"
          loading="lazy"
          widths={[400, 800, 1200]}
          sizes="(max-width: 760px) 90vw, 40vw"
        />
      </div>
      <div class="proj-body">
        <div class="proj-meta">
          <span class="project-status status-live">Live</span>
          <span class="proj-tagline">KI-Tool für Content-Creator</span>
        </div>
        <h3 class="proj-feature-name">Skriptgenerator</h3>

        <div class="proj-block">
          <span class="proj-label">Was es macht</span>
          <p class="proj-block-text">Verwandelt Stichpunkte in fertige Skripte für YouTube Shorts, Reels und TikTok. In wenigen Minuten statt Stunden.</p>
        </div>
        <div class="proj-block">
          <span class="proj-label">Was KI daran ist</span>
          <p class="proj-block-text">Die KI lernt deinen Schreibstil aus früheren Skripten und schreibt neue, die nach dir klingen — nicht nach generischem KI-Output.</p>
        </div>

        <a class="project-link" href="https://skriptgenerator.com" target="_blank" rel="noopener noreferrer">skriptgenerator.com <span class="arrow">→</span></a>
      </div>
    </article>

    <article class="proj-spread proj-spread--mirror reveal">
      <div class="project-media">
        <Image
          src={garageImg}
          alt="Garage App — Sammlung mit Porsche 911, VW Käfer, Mercedes Pagode"
          loading="lazy"
          widths={[400, 800, 1200]}
          sizes="(max-width: 760px) 90vw, 40vw"
        />
      </div>
      <div class="proj-body">
        <div class="proj-meta">
          <span class="project-status status-beta">In geschlossener Beta</span>
          <span class="proj-tagline">Voice-First Bordbuch</span>
        </div>
        <h3 class="proj-feature-name">Garage</h3>

        <div class="proj-block">
          <span class="proj-label">Was es macht</span>
          <p class="proj-block-text">Digitales Bordbuch für Oldtimer-Sammler. Wartungen, Werkstatt-Besuche und Kosten werden per Sprache erfasst — kein Tippen, keine Excel-Tabellen mehr.</p>
        </div>
        <div class="proj-block">
          <span class="proj-label">Was KI daran ist</span>
          <p class="proj-block-text">Die KI versteht Sammler-Sprache (Pagode, Käfer), erkennt welche Werkstatt gemeint ist und welcher Wagen aus deiner Sammlung — und legt den Eintrag automatisch richtig an.</p>
        </div>
      </div>
    </article>

  </div>
</section>
