---
---
<section class="zone principle">
  <div class="container">
    <div class="reveal" style="display:flex; justify-content:center">
      <div class="kicker"><span class="rule"></span><span>Wie wir arbeiten</span></div>
    </div>
    <h2 class="reveal">Keine Software. Kein Abo. Keine Überraschungen.</h2>

    <div class="ledger ledger-rich reveal">
      <div class="ledger-step">
        <span class="step-num">i.</span>
        <h3>[SCHRITT_1_HEADLINE_PLATZHALTER]</h3>
        <!-- Aktuell: "Du sagst uns wie du arbeitest." -->
        <p>[SCHRITT_1_ERKLAERUNG_PLATZHALTER]</p>
        <span class="ledger-meta">[SCHRITT_1_DAUER_PLATZHALTER]</span>
        <!-- Empfehlung Dauer: "30 Minuten Erstgespräch" -->
      </div>
      <div class="ledger-step">
        <span class="step-num">ii.</span>
        <h3>[SCHRITT_2_HEADLINE_PLATZHALTER]</h3>
        <!-- Aktuell: "Wir bauen die KI die das übernimmt." -->
        <p>[SCHRITT_2_ERKLAERUNG_PLATZHALTER]</p>
        <span class="ledger-meta">[SCHRITT_2_DAUER_PLATZHALTER]</span>
        <!-- Empfehlung Dauer: "1-3 Wochen Aufbau" -->
      </div>
      <div class="ledger-step">
        <span class="step-num">iii.</span>
        <h3>[SCHRITT_3_HEADLINE_PLATZHALTER]</h3>
        <!-- Aktuell: "Einmal bezahlt. Dauerhaft im Einsatz." -->
        <p>[SCHRITT_3_ERKLAERUNG_PLATZHALTER]</p>
        <span class="ledger-meta">[SCHRITT_3_DAUER_PLATZHALTER]</span>
        <!-- Empfehlung Dauer: "Ab Tag 1 produktiv" -->
      </div>
    </div>
  </div>
</section>
