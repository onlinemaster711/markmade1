---
---
<section class="hero">
  <div class="hero-grid">
    <div class="hero-meta reveal">
      <div class="kicker"><span class="rule"></span><span>[HERO_EYEBROW_PLATZHALTER]</span></div>
      <!-- Aktuell: "KI Agentur · Stuttgart" zwischen zwei <hr> -->
      <!-- Empfehlung Default: "KI-Agentur · Stuttgart" -->
    </div>

    <h1 class="hero-h1 reveal">
      [HERO_HEADLINE_PLATZHALTER_TEIL_1]<br>
      [HERO_HEADLINE_PLATZHALTER_TEIL_2] <span class="em">[HERO_HEADLINE_PLATZHALTER_AKZENT]</span>
      <span class="hero-h1-subtitle">[H1_SEO_SUBTITLE_PLATZHALTER]</span>
      <!-- Aktuell: "KI macht / dich besser." — Slogan bleibt -->
      <!-- Empfehlung Subtitle: "KI-Agentur aus Stuttgart" -->
    </h1>

    <div class="hero-sub reveal">
      <p>[HERO_SUBLINE_PLATZHALTER]</p>
      <!-- Aktuell: "Eine Person mit KI schlägt ein Team ohne." -->
    </div>

    <div class="hero-cta reveal">
      <a class="btn btn-lg" href="https://calendly.com/onlinemaster711/new-meeting" target="_blank" rel="noopener noreferrer">Gespräch buchen <span class="arrow">→</span></a>
      <a class="hero-scroll-link" href="#projekte">↓ [HERO_SCROLL_LINK_TEXT_PLATZHALTER]</a>
    </div>

    <div class="hero-stats reveal">
      <div class="stat">
        <div class="num">24<span class="unit">/ 7</span></div>
        <div class="lbl">Erreichbarkeit</div>
      </div>
      <div class="stat">
        <div class="num">8<span class="unit">statt 40</span></div>
        <div class="lbl">Mails am Tag</div>
      </div>
      <div class="stat">
        <div class="num">&lt; 5<span class="unit">Min.</span></div>
        <div class="lbl">Bis zur Bestätigung</div>
      </div>
      <div class="stat">
        <div class="num">1×<span class="unit">bezahlt</span></div>
        <div class="lbl">Kein Abo</div>
      </div>
    </div>
  </div>
</section>
