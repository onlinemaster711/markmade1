<section class="hero">
  <div class="hero-grid">
    <div class="hero-meta reveal">
      <div class="kicker"><span class="rule"></span><span>KI-Agentur · Stuttgart</span></div>
    </div>

    <h1 class="hero-h1 reveal">
      KI macht<br>
      dich <span class="em">besser.</span>
      <span class="hero-h1-subtitle">KI-Agentur aus Stuttgart</span>
    </h1>

    <div class="hero-sub reveal">
      <p>Wir bauen eigene KI-Anwendungen. Und übersetzen das, was wir gelernt haben, in Lösungen für deinen Betrieb.</p>
    </div>

    <div class="hero-cta reveal">
      <a class="btn btn-lg" href="https://calendly.com/onlinemaster711/new-meeting" target="_blank" rel="noopener noreferrer">Gespräch buchen <span class="arrow">→</span></a>
      <a class="hero-scroll-link" href="#projekte">↓ Was wir bauen</a>
    </div>

    <div class="hero-stats reveal">
      <div class="stat">
        <div class="num">24<span class="unit">/ 7</span></div>
        <div class="lbl">Erreichbarkeit</div>
      </div>
      <div class="stat">
        <div class="num">8<span class="unit">statt 40</span></div>
        <div class="lbl">Mails am Tag</div>
      </div>
      <div class="stat">
        <div class="num">&lt; 5<span class="unit">Min.</span></div>
        <div class="lbl">Bis zur Bestätigung</div>
      </div>
      <div class="stat">
        <div class="num">1×<span class="unit">bezahlt</span></div>
        <div class="lbl">Kein Abo</div>
      </div>
    </div>
  </div>
</section>
