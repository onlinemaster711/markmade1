---
import LandingLayout from '../layouts/LandingLayout.astro';
import Nav from '../components/Nav.astro';
import LandingHero from '../components/LandingHero.astro';
import LandingProjects from '../components/LandingProjects.astro';
import LandingServices from '../components/LandingServices.astro';
import Principle from '../components/Principle.astro';
import LandingFaq from '../components/LandingFaq.astro';
import LandingCta from '../components/LandingCta.astro';
import LandingFooter from '../components/LandingFooter.astro';
// LandingWasKiMacht wird in der neuen Reihenfolge nicht mehr eingebunden.
// Datei bleibt im Repo (src/components/LandingWasKiMacht.astro) — keine Löschung.
---

<LandingLayout
  title="MarkMade — KI-Agentur Stuttgart"
  description="KI-Agentur in Stuttgart. Wir bauen Telefonassistenten, Chatbots, E-Mail-Automatisierung und Custom-KI-Lösungen. Eigene Projekte als Beweis."
>
  <Nav />
  <LandingHero />
  <LandingProjects />
  <LandingServices />
  <Principle />
  <LandingFaq />
  <LandingCta />
  <LandingFooter />
</LandingLayout>

<script>
  // Reveal-on-scroll
  const io = new IntersectionObserver((entries) => {
    entries.forEach(e => {
      if (e.isIntersecting) {
        e.target.classList.add('in');
        io.unobserve(e.target);
      }
    });
  }, { threshold: 0.12, rootMargin: '0px 0px -40px 0px' });
  document.querySelectorAll('.reveal').forEach(el => io.observe(el));

  // Steps active aside (legacy: betraf .step-Elemente in LandingWasKiMacht)
  // Bleibt drin — querySelectorAll auf nicht vorhandene .step-Elemente ist no-op.
  // Aufräumen in Phase 2 Visual Cleanup.
  const stepsObs = new IntersectionObserver((entries) => {
    entries.forEach(e => {
      if (e.isIntersecting) {
        const target = e.target as HTMLElement;
        const id = target.dataset.step;
        document.querySelectorAll<HTMLElement>('.step-link').forEach(l => {
          l.classList.toggle('active', l.dataset.step === id);
        });
      }
    });
  }, { threshold: 0.5 });
  document.querySelectorAll('.step').forEach(s => stepsObs.observe(s));
</script>
