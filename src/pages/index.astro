---
import LandingLayout from '../layouts/LandingLayout.astro';
import Nav from '../components/Nav.astro';
import LandingHero from '../components/LandingHero.astro';
import LandingServices from '../components/LandingServices.astro';
import LandingProjects from '../components/LandingProjects.astro';
import LandingTrust from '../components/LandingTrust.astro';
import Principle from '../components/Principle.astro';
import LandingFaq from '../components/LandingFaq.astro';
import LandingCta from '../components/LandingCta.astro';
import LandingFooter from '../components/LandingFooter.astro';
---

<LandingLayout
  title="MarkMade — KI-Agentur Stuttgart"
  description="KI-Agentur in Stuttgart. Wir bauen Telefonassistenten, Chatbots, E-Mail-Automatisierung und Custom-KI-Lösungen. Eigene Projekte als Beweis."
>
  <Nav />
  <LandingHero />
  <LandingServices />
  <LandingProjects />
  <LandingTrust />
  <Principle />
  <LandingFaq />
  <LandingCta />
  <LandingFooter />
</LandingLayout>

<script>
  // Reveal-on-scroll für alle .reveal-Elemente
  const io = new IntersectionObserver((entries) => {
    entries.forEach(e => {
      if (e.isIntersecting) {
        e.target.classList.add('in');
        io.unobserve(e.target);
      }
    });
  }, { threshold: 0.12, rootMargin: '0px 0px -40px 0px' });
  document.querySelectorAll('.reveal').forEach(el => io.observe(el));
</script>
